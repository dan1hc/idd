#!/usr/bin/env bash
set -euo pipefail

IDD_VERSION="3.3.0"
IDD_DIR="$(cd "$(dirname "$0")" && pwd)"
IDD_ROOT="$(cd "$IDD_DIR/../.." && pwd)"
PROMPTS_DIR="$IDD_DIR/prompts"
RUN_TEMPLATE="$PROMPTS_DIR/run.md"
CONVENTIONS_TEMPLATE="$PROMPTS_DIR/conventions.md"

# --- Colors ---
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

usage() {
  cat <<EOF
${BOLD}idd${NC} v${IDD_VERSION} — Intent-Driven Development

${BOLD}Usage:${NC}
  idd init                               Scaffold files, copy instructions, and auto-populate conventions
  idd learn --type <type> ...            Add a typed learned rule to learned.json
  idd refresh-conventions                Re-analyze the repo and overwrite conventions.json via Copilot CLI
  idd run [--feature <name>] <task>      Execute a task through Copilot CLI with IDD artifacts injected
  idd validate [--feature <name>]        Validate IDD artifacts and feature glossary anchors

${BOLD}Files:${NC}
  .github/idd/conventions.json           Project conventions (AI-populated per schema)
  .github/idd/learned.json               Enforceable learned rules
  .github/idd/instructions.md            AI reads this (copied to tool locations)
  .github/idd/features/*.md              Feature specs (AI reads directly)
  .github/idd/prompts/*.md               Prompt envelopes used by IDD commands

${BOLD}Runner:${NC}
  idd init and idd refresh-conventions populate conventions.json through
  Copilot CLI. idd run injects the relevant IDD artifacts before editing code.

${BOLD}Validator:${NC}
  idd validate checks required artifacts, enforces typed learned rules, and
  validates feature status/checklists plus glossary anchor resolution.

EOF
}

die() {
  echo -e "${RED}$*${NC}" >&2
  exit 1
}

warn() {
  echo -e "${YELLOW}⚠${NC} $*"
}

info() {
  echo -e "${CYAN}ℹ${NC} $*"
}

success() {
  echo -e "${GREEN}✓${NC} $*"
}

ensure_file() {
  local path="$1"
  local message="$2"
  [[ -f "$path" ]] || die "$message"
}

resolve_feature_path() {
  local value="${1:-}"

  if [[ -z "$value" ]]; then
    return 0
  fi

  if [[ -f "$value" ]]; then
    printf '%s\n' "$value"
    return 0
  fi

  if [[ -f "$IDD_ROOT/$value" ]]; then
    printf '%s\n' "$IDD_ROOT/$value"
    return 0
  fi

  if [[ -f "$IDD_DIR/features/$value" ]]; then
    printf '%s\n' "$IDD_DIR/features/$value"
    return 0
  fi

  if [[ -f "$IDD_DIR/features/$value.md" ]]; then
    printf '%s\n' "$IDD_DIR/features/$value.md"
    return 0
  fi

  die "Feature not found: $value"
}

relative_to_root() {
  local path="$1"
  python3 - "$IDD_ROOT" "$path" <<'PYEOF'
from pathlib import Path
import sys

root = Path(sys.argv[1]).resolve()
path = Path(sys.argv[2]).resolve()
try:
    print(path.relative_to(root))
except ValueError:
    print(path)
PYEOF
}

conventions_ready() {
  python3 - "$IDD_DIR/conventions.json" <<'PYEOF'
import json, sys
from pathlib import Path

path = Path(sys.argv[1])
if not path.exists():
    raise SystemExit(1)

data = json.loads(path.read_text())
status = data.get("status")
required = ["language", "formatting", "detected_at"]

if status == "pending" or any(key not in data or data.get(key) in (None, "") for key in required):
    raise SystemExit(1)
PYEOF
}

detect_copilot_cmd() {
  if [[ -n "${IDD_COPILOT_CMD:-}" ]]; then
    printf '%s\n' "$IDD_COPILOT_CMD"
    return 0
  fi

  if command -v copilot >/dev/null 2>&1; then
    command -v copilot
    return 0
  fi

  die "Copilot CLI not found. Install it or set IDD_COPILOT_CMD to a compatible command."
}

render_run_prompt() {
  local task="$1"
  local feature_path="${2:-}"
  local output_path="$3"
  local feature_rel=""

  ensure_file "$RUN_TEMPLATE" "Missing run prompt template at .github/idd/prompts/run.md"

  if [[ -n "$feature_path" ]]; then
    feature_rel="$(relative_to_root "$feature_path")"
  fi

  IDD_TASK="$task" \
  IDD_TEMPLATE="$RUN_TEMPLATE" \
  IDD_OUTPUT="$output_path" \
  IDD_FEATURE_REL="$feature_rel" \
  python3 <<'PYEOF'
import os
from pathlib import Path

template = Path(os.environ["IDD_TEMPLATE"]).read_text()
task = os.environ["IDD_TASK"]
output = Path(os.environ["IDD_OUTPUT"])
feature_rel = os.environ.get("IDD_FEATURE_REL", "")

artifacts = [
    ".github/idd/instructions.md",
    ".github/idd/conventions.json",
    ".github/idd/learned.json",
]

if feature_rel:
    artifacts.append(feature_rel)
    feature_context = (
        f"Feature spec in scope: {feature_rel}\n"
        "Treat its acceptance criteria and glossary updates as mandatory."
    )
else:
    feature_context = (
        "No feature spec was provided. If implementation work begins, create a new feature "
        "spec from .github/idd/features/_template.md before changing code, then update its "
        "status, checklist, and glossary before finishing."
    )

artifact_list = "\n".join(f"- {artifact}" for artifact in artifacts)

prompt = (
    template.replace("{{TASK}}", task)
    .replace("{{ARTIFACT_LIST}}", artifact_list)
    .replace("{{FEATURE_CONTEXT}}", feature_context)
)

output.write_text(prompt)
PYEOF
}

render_conventions_prompt() {
  local output_path="$1"

  ensure_file "$CONVENTIONS_TEMPLATE" "Missing conventions prompt template at .github/idd/prompts/conventions.md"
  cp "$CONVENTIONS_TEMPLATE" "$output_path"
}

invoke_copilot_prompt_file() {
  local prompt_file="$1"
  local action="$2"
  local model="${3:-${IDD_COPILOT_MODEL:-}}"
  local effort="${4:-${IDD_COPILOT_REASONING_EFFORT:-}}"
  local copilot_cmd
  copilot_cmd="$(detect_copilot_cmd)"

  local -a cmd
  if [[ -n "${IDD_COPILOT_CMD:-}" ]]; then
    read -r -a cmd <<<"$copilot_cmd"
  else
    cmd=("$copilot_cmd")
  fi

  cmd+=(
    -p "$(<"$prompt_file")"
    --add-dir "$IDD_ROOT"
    --allow-all-tools
    --output-format text
    --stream off
    --silent
    --no-ask-user
  )

  if [[ -n "$model" ]]; then
    cmd+=(--model "$model")
  fi

  if [[ -n "$effort" ]]; then
    cmd+=(--reasoning-effort "$effort")
  fi

  info "$action"
  "${cmd[@]}"
}

cmd_learn() {
  local type=""
  local glob=""
  local module=""
  local pattern=""
  local message=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --type)
        [[ $# -gt 1 ]] || die '--type requires a value'
        type="$2"
        shift 2
        ;;
      --glob)
        [[ $# -gt 1 ]] || die '--glob requires a value'
        glob="$2"
        shift 2
        ;;
      --module)
        [[ $# -gt 1 ]] || die '--module requires a value'
        module="$2"
        shift 2
        ;;
      --pattern)
        [[ $# -gt 1 ]] || die '--pattern requires a value'
        pattern="$2"
        shift 2
        ;;
      --message)
        [[ $# -gt 1 ]] || die '--message requires a value'
        message="$2"
        shift 2
        ;;
      -h|--help)
        cat <<EOF
Usage: idd learn --type <type> --glob <glob> [target flags] [--message <text>]

Types:
  forbid_import    Requires: --module
  require_import   Requires: --module
  forbid_pattern   Requires: --pattern
  require_pattern  Requires: --pattern

Examples:
  idd learn --type forbid_import --glob "src/services/**/*.py" --module httpx \
    --message "Use BaseClient from src/clients/base.py instead of raw httpx"

  idd learn --type forbid_import --glob "src/services/**/*.py" --module routes \
    --message "Services must not import from routes"

  idd learn --type require_pattern --glob "src/public/**/*.py" \
    --pattern "def .+->" --message "Public functions must declare return types"
EOF
        return
        ;;
      *)
        die "Unknown option for learn: $1"
        ;;
    esac
  done

  [[ -n "$type" ]] || die '--type is required'
  [[ -n "$glob" ]] || die '--glob is required'

  case "$type" in
    forbid_import|require_import)
      [[ -n "$module" ]] || die "--module is required for $type"
      [[ -z "$pattern" ]] || die "--pattern is not valid for $type"
      ;;
    forbid_pattern|require_pattern)
      [[ -n "$pattern" ]] || die "--pattern is required for $type"
      [[ -z "$module" ]] || die "--module is not valid for $type"
      ;;
    *)
      die "Unsupported rule type: $type"
      ;;
  esac

  if [[ -z "$message" ]]; then
    case "$type" in
      forbid_import)
        message="Disallow importing $module in $glob"
        ;;
      require_import)
        message="Require importing $module in $glob"
        ;;
      forbid_pattern)
        message="Disallow pattern $pattern in $glob"
        ;;
      require_pattern)
        message="Require pattern $pattern in $glob"
        ;;
    esac
  fi

  local learned="$IDD_DIR/learned.json"
  if [[ ! -f "$learned" ]]; then
    echo '{"rules":[]}' > "$learned"
  fi

  IDD_RULE_TYPE="$type" \
  IDD_RULE_GLOB="$glob" \
  IDD_RULE_MODULE="$module" \
  IDD_RULE_PATTERN="$pattern" \
  IDD_RULE_MESSAGE="$message" \
  IDD_LEARNED="$learned" python3 <<'PYEOF'
import json, os
from datetime import datetime, timezone

path = os.environ["IDD_LEARNED"]
rule_type = os.environ["IDD_RULE_TYPE"]
glob = os.environ["IDD_RULE_GLOB"]
module = os.environ.get("IDD_RULE_MODULE", "")
pattern = os.environ.get("IDD_RULE_PATTERN", "")
message = os.environ["IDD_RULE_MESSAGE"]

with open(path) as f:
    data = json.load(f)

ids = [r["id"] for r in data.get("rules", [])]
next_id = max(ids) + 1 if ids else 1

data["rules"].append({
    "id": next_id,
    "type": rule_type,
    "glob": glob,
    "module": module or None,
    "pattern": pattern or None,
    "message": message,
    "added": datetime.now(timezone.utc).strftime("%Y-%m-%d"),
})

with open(path, "w") as f:
    json.dump(data, f, indent=2)
    f.write("\n")

target = module or pattern
print(f"\033[0;32m✓\033[0m Learned rule #{next_id}: {rule_type} ({glob}) -> {target}")
PYEOF
}

cmd_init() {
  cd "$IDD_ROOT"
  echo -e "${BOLD}Initializing IDD v${IDD_VERSION}${NC}\n"

  mkdir -p "$IDD_DIR/schemas" "$IDD_DIR/features" "$PROMPTS_DIR"

  if [[ ! -f "$IDD_DIR/learned.json" ]]; then
    echo '{"rules":[]}' > "$IDD_DIR/learned.json"
    success "Created learned.json"
  fi

  if [[ ! -f "$IDD_DIR/conventions.json" ]]; then
    python3 -c "
import json
data = {
    'idd_version': '$IDD_VERSION',
    'status': 'pending',
    'detected_at': None,
    'schema': '.github/idd/schemas/conventions.schema.json',
    'message': 'AI will populate this on first session. See instructions.md.'
}
with open('$IDD_DIR/conventions.json', 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
"
    success "Created conventions.json (status: pending — AI will populate)"
  else
    info "conventions.json already exists"
  fi

  if [[ ! -f "$IDD_DIR/features/_template.md" ]]; then
    warn 'features/_template.md not found — download from github.com/dan1hc/idd'
  fi

  if [[ ! -f "$RUN_TEMPLATE" ]]; then
    warn 'prompts/run.md not found — download from github.com/dan1hc/idd'
  fi

  if [[ ! -f "$CONVENTIONS_TEMPLATE" ]]; then
    warn 'prompts/conventions.md not found — download from github.com/dan1hc/idd'
  fi

  local src="$IDD_DIR/instructions.md"
  if [[ ! -f "$src" ]]; then
    warn 'instructions.md not found — download from github.com/dan1hc/idd'
    return
  fi

  local copied=0

  cp "$src" "$IDD_ROOT/.cursorrules" 2>/dev/null && copied=$((copied + 1)) && \
    success 'Copied → .cursorrules'

  cp "$src" "$IDD_ROOT/CLAUDE.md" 2>/dev/null && copied=$((copied + 1)) && \
    success 'Copied → CLAUDE.md'

  mkdir -p "$IDD_ROOT/.github"
  cp "$src" "$IDD_ROOT/.github/copilot-instructions.md" 2>/dev/null && copied=$((copied + 1)) && \
    success 'Copied → .github/copilot-instructions.md'

  if conventions_ready; then
    info 'conventions.json already populated'
  else
    cmd_refresh_conventions
  fi

  echo ""
  success "Instructions placed in ${copied} tool location(s)."
  echo ""
  echo 'Start here:'
  echo '  1. Run: idd run --feature <name> "your task"'
  echo '  2. Check: idd validate --feature <name>'
  echo '  3. Optional: idd learn --type forbid_import --glob "src/**/*.py" --module httpx --message "Use BaseClient"'
}

cmd_refresh_conventions() {
  local dry_run=0
  local print_prompt=0
  local model="${IDD_COPILOT_MODEL:-}"
  local effort="${IDD_COPILOT_REASONING_EFFORT:-}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)
        dry_run=1
        shift
        ;;
      --print-prompt)
        print_prompt=1
        shift
        ;;
      --model)
        [[ $# -gt 1 ]] || die '--model requires a value'
        model="$2"
        shift 2
        ;;
      --reasoning-effort|--effort)
        [[ $# -gt 1 ]] || die '--reasoning-effort requires a value'
        effort="$2"
        shift 2
        ;;
      -h|--help)
        cat <<EOF
Usage: idd refresh-conventions [--print-prompt] [--dry-run] [--model <model>] [--reasoning-effort <level>]

Examples:
  idd refresh-conventions
  idd refresh-conventions --print-prompt
EOF
        return
        ;;
      *)
        die "Unknown option for refresh-conventions: $1"
        ;;
    esac
  done

  ensure_file "$IDD_DIR/instructions.md" 'Missing .github/idd/instructions.md. Run idd init.'
  ensure_file "$IDD_DIR/schemas/conventions.schema.json" 'Missing .github/idd/schemas/conventions.schema.json. Run idd init.'

  if [[ ! -f "$IDD_DIR/conventions.json" ]]; then
    echo '{"idd_version":"'$IDD_VERSION'","status":"pending","detected_at":null,"schema": ".github/idd/schemas/conventions.schema.json","message":"AI will populate this during init."}' > "$IDD_DIR/conventions.json"
  fi

  local prompt_file
  prompt_file="$(mktemp)"
  trap "rm -f \"$prompt_file\"" EXIT

  render_conventions_prompt "$prompt_file"

  if [[ "$print_prompt" -eq 1 || "$dry_run" -eq 1 ]]; then
    cat "$prompt_file"
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    return
  fi

  invoke_copilot_prompt_file "$prompt_file" 'Populating conventions.json via Copilot CLI' "$model" "$effort"
  conventions_ready || die 'Copilot CLI completed but conventions.json is still pending or incomplete.'
  success 'Populated conventions.json'
}

cmd_run() {
  local feature_arg=""
  local feature_path=""
  local task=""
  local dry_run=0
  local print_prompt=0
  local model="${IDD_COPILOT_MODEL:-}"
  local effort="${IDD_COPILOT_REASONING_EFFORT:-}"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --feature)
        [[ $# -gt 1 ]] || die '--feature requires a value'
        feature_arg="$2"
        shift 2
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      --print-prompt)
        print_prompt=1
        shift
        ;;
      --model)
        [[ $# -gt 1 ]] || die '--model requires a value'
        model="$2"
        shift 2
        ;;
      --reasoning-effort|--effort)
        [[ $# -gt 1 ]] || die '--reasoning-effort requires a value'
        effort="$2"
        shift 2
        ;;
      -h|--help)
        cat <<EOF
Usage: idd run [--feature <name>] [--print-prompt] [--dry-run] [--model <model>] [--reasoning-effort <level>] <task>

Examples:
  idd run --feature users-api "Add a POST /users endpoint"
  idd run --print-prompt "Create a feature spec for password reset"

Environment:
  IDD_COPILOT_CMD                 Override Copilot CLI command
  IDD_COPILOT_MODEL               Default model passed to copilot
  IDD_COPILOT_REASONING_EFFORT    Default reasoning effort passed to copilot
EOF
        return
        ;;
      --)
        shift
        break
        ;;
      *)
        task+="${task:+ }$1"
        shift
        ;;
    esac
  done

  if [[ $# -gt 0 ]]; then
    task+="${task:+ }$*"
  fi

  [[ -n "$task" ]] || die 'Usage: idd run [--feature <name>] <task>'

  ensure_file "$IDD_DIR/instructions.md" 'Missing .github/idd/instructions.md. Run idd init.'
  ensure_file "$IDD_DIR/learned.json" 'Missing .github/idd/learned.json. Run idd init.'
  ensure_file "$IDD_DIR/conventions.json" 'Missing .github/idd/conventions.json. Run idd init.'
  conventions_ready || die 'conventions.json is pending or incomplete. Run idd refresh-conventions.'

  if [[ -n "$feature_arg" ]]; then
    feature_path="$(resolve_feature_path "$feature_arg")"
  fi

  local prompt_file
  prompt_file="$(mktemp)"
  trap "rm -f \"$prompt_file\"" EXIT

  render_run_prompt "$task" "$feature_path" "$prompt_file"

  if [[ "$print_prompt" -eq 1 || "$dry_run" -eq 1 ]]; then
    cat "$prompt_file"
  fi

  if [[ "$dry_run" -eq 1 ]]; then
    return
  fi

  invoke_copilot_prompt_file "$prompt_file" 'Running Copilot CLI with IDD prompt envelope' "$model" "$effort"
}

cmd_validate() {
  local feature_arg=""
  local feature_path=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --feature)
        [[ $# -gt 1 ]] || die '--feature requires a value'
        feature_arg="$2"
        shift 2
        ;;
      -h|--help)
        cat <<EOF
Usage: idd validate [--feature <name>]

Examples:
  idd validate
  idd validate --feature users-api
EOF
        return
        ;;
      *)
        die "Unknown option for validate: $1"
        ;;
    esac
  done

  if [[ -n "$feature_arg" ]]; then
    feature_path="$(resolve_feature_path "$feature_arg")"
  fi

  IDD_ROOT="$IDD_ROOT" IDD_DIR="$IDD_DIR" IDD_FEATURE="$feature_path" python3 <<'PYEOF'
import json
import os
import re
import sys
from pathlib import Path

root = Path(os.environ["IDD_ROOT"])
idd_dir = Path(os.environ["IDD_DIR"])
feature_arg = os.environ.get("IDD_FEATURE", "")

errors = []
warnings = []

required_files = [
    (idd_dir / "instructions.md", "Missing .github/idd/instructions.md"),
    (idd_dir / "learned.json", "Missing .github/idd/learned.json"),
    (idd_dir / "conventions.json", "Missing .github/idd/conventions.json"),
    (idd_dir / "features" / "_template.md", "Missing .github/idd/features/_template.md"),
]

for path, message in required_files:
    if not path.exists():
        errors.append(message)

conventions_path = idd_dir / "conventions.json"
if conventions_path.exists():
    try:
        conventions = json.loads(conventions_path.read_text())
    except json.JSONDecodeError as exc:
        errors.append(f"Invalid JSON in .github/idd/conventions.json: {exc}")
        conventions = {}
    else:
        if conventions.get("status") == "pending":
            errors.append("conventions.json is still pending")
        for key in ("language", "formatting", "detected_at"):
            if key not in conventions or conventions.get(key) in (None, ""):
                errors.append(f"conventions.json missing required field: {key}")

learned_path = idd_dir / "learned.json"
learned = {"rules": []}
if learned_path.exists():
    try:
        learned = json.loads(learned_path.read_text())
    except json.JSONDecodeError as exc:
        errors.append(f"Invalid JSON in .github/idd/learned.json: {exc}")
        learned = {"rules": []}
    else:
        if not isinstance(learned, dict) or not isinstance(learned.get("rules"), list):
            errors.append("learned.json must be an object with a rules array")
            learned = {"rules": []}

allowed_statuses = {"draft", "in-progress", "partial", "complete"}
allowed_rule_types = {"forbid_import", "require_import", "forbid_pattern", "require_pattern"}

def find_section(text: str, heading: str):
    pattern = re.compile(rf"^## {re.escape(heading)}\s*$", re.MULTILINE)
    match = pattern.search(text)
    if not match:
        return None
    start = match.end()
    next_match = re.search(r"^## ", text[start:], re.MULTILINE)
    end = start + next_match.start() if next_match else len(text)
    return text[start:end]

def symbol_exists(content: str, symbol: str) -> bool:
    if symbol.startswith("#feature:"):
        return symbol in content or symbol.split(":", 1)[1] in content

    class_name = None
    target = symbol
    if "." in symbol:
        class_name, target = symbol.rsplit(".", 1)

    patterns = [
        rf"^\s*(?:async\s+)?def\s+{re.escape(target)}\b",
        rf"^\s*(?:export\s+)?(?:async\s+)?function\s+{re.escape(target)}\b",
        rf"^\s*(?:export\s+)?(?:const|let|var)\s+{re.escape(target)}\b",
        rf"^\s*class\s+{re.escape(target)}\b",
        rf"^\s*struct\s+{re.escape(target)}\b",
        rf"^\s*enum\s+{re.escape(target)}\b",
        rf"^\s*interface\s+{re.escape(target)}\b",
        rf"^\s*type\s+{re.escape(target)}\b",
        rf"^\s*func\s+{re.escape(target)}\b",
        rf"^\s*(?:public\s+|private\s+|protected\s+)?(?:async\s+)?{re.escape(target)}\s*\(",
    ]

    if class_name:
        class_target = class_name.split(".")[0]
        class_patterns = [
            rf"^\s*class\s+{re.escape(class_target)}\b",
            rf"^\s*struct\s+{re.escape(class_target)}\b",
            rf"^\s*interface\s+{re.escape(class_target)}\b",
        ]
        if not any(re.search(pattern, content, re.MULTILINE) for pattern in class_patterns):
            return False

    return any(re.search(pattern, content, re.MULTILINE) for pattern in patterns)

def file_matches_rule(root_path: Path, glob_pattern: str):
    return sorted(path for path in root_path.glob(glob_pattern) if path.is_file())

def has_import(content: str, module: str) -> bool:
    escaped = re.escape(module)
    patterns = [
        rf"^\s*from\s+{escaped}(?:\.|\s)",
        rf"^\s*import\s+{escaped}(?:\s|$|,)",
        rf"^\s*import\s+.*\b{escaped}\b",
        rf"^\s*export\s+.*from\s+[\"']{escaped}[\"']",
        rf"^\s*import\s+.*from\s+[\"']{escaped}[\"']",
        rf"^\s*import\s+[\"']{escaped}[\"']",
        rf"require\(\s*[\"']{escaped}[\"']\s*\)",
    ]
    return any(re.search(pattern, content, re.MULTILINE) for pattern in patterns)

def enforce_learned_rules():
    for rule in learned.get("rules", []):
        if not isinstance(rule, dict):
            errors.append("learned.json contains a non-object rule entry")
            continue

        rule_id = rule.get("id")
        rule_type = rule.get("type")
        glob_pattern = rule.get("glob")
        message = rule.get("message")
        module = rule.get("module")
        pattern = rule.get("pattern")
        added = rule.get("added")

        prefix = f"learned rule #{rule_id}" if rule_id is not None else "learned rule"

        if not isinstance(rule_id, int) or rule_id < 1:
            errors.append(f"{prefix}: id must be a positive integer")
            continue
        if rule_type not in allowed_rule_types:
            errors.append(f"{prefix}: unsupported type '{rule_type}'")
            continue
        if not isinstance(glob_pattern, str) or not glob_pattern:
            errors.append(f"{prefix}: glob must be a non-empty string")
            continue
        if not isinstance(message, str) or not message:
            errors.append(f"{prefix}: message must be a non-empty string")
            continue
        if not isinstance(added, str) or not re.fullmatch(r"\d{4}-\d{2}-\d{2}", added):
            errors.append(f"{prefix}: added must be YYYY-MM-DD")
            continue

        compiled_pattern = None
        if rule_type in {"forbid_import", "require_import"}:
            if not isinstance(module, str) or not module:
                errors.append(f"{prefix}: module must be a non-empty string for {rule_type}")
                continue
            if pattern not in (None, ""):
                errors.append(f"{prefix}: pattern is not valid for {rule_type}")
                continue
        else:
            if not isinstance(pattern, str) or not pattern:
                errors.append(f"{prefix}: pattern must be a non-empty string for {rule_type}")
                continue
            if module not in (None, ""):
                errors.append(f"{prefix}: module is not valid for {rule_type}")
                continue
            try:
                compiled_pattern = re.compile(pattern, re.MULTILINE)
            except re.error as exc:
                errors.append(f"{prefix}: invalid regex pattern '{pattern}': {exc}")
                continue

        matched_files = file_matches_rule(root, glob_pattern)
        if not matched_files:
            warnings.append(f"{prefix}: no files matched glob {glob_pattern}")
            continue

        for path in matched_files:
            rel_path = path.relative_to(root)
            try:
                content = path.read_text()
            except UnicodeDecodeError:
                warnings.append(f"{prefix}: skipped non-text file {rel_path}")
                continue

            if rule_type == "forbid_import" and has_import(content, module):
                errors.append(f"{prefix}: {rel_path} imports forbidden module '{module}' ({message})")
            elif rule_type == "require_import" and not has_import(content, module):
                errors.append(f"{prefix}: {rel_path} is missing required module '{module}' ({message})")
            elif rule_type == "forbid_pattern" and compiled_pattern.search(content):
                errors.append(f"{prefix}: {rel_path} matches forbidden pattern '{pattern}' ({message})")
            elif rule_type == "require_pattern" and not compiled_pattern.search(content):
                errors.append(f"{prefix}: {rel_path} is missing required pattern '{pattern}' ({message})")

def validate_feature(path: Path):
    text = path.read_text()
    rel_path = path.relative_to(root)

    status_match = re.search(r"^> \*\*Status\*\*: `([^`]+)`", text, re.MULTILINE)
    if not status_match:
        errors.append(f"{rel_path}: missing status line")
        status = None
    else:
        status = status_match.group(1)
        if status not in allowed_statuses:
            errors.append(f"{rel_path}: invalid status '{status}'")

    acceptance = find_section(text, "Acceptance Criteria")
    if acceptance is None:
        errors.append(f"{rel_path}: missing Acceptance Criteria section")
        checkboxes = []
    else:
        checkboxes = re.findall(r"^- \[( |x)\]", acceptance, re.MULTILINE)
        if not checkboxes:
            errors.append(f"{rel_path}: Acceptance Criteria has no checkbox items")

    checked = sum(1 for value in checkboxes if value == "x")
    unchecked = sum(1 for value in checkboxes if value == " ")

    if status == "complete" and unchecked:
        errors.append(f"{rel_path}: status is complete but {unchecked} acceptance criteria remain unchecked")
    if status == "draft" and checked:
        warnings.append(f"{rel_path}: status is draft but some acceptance criteria are already checked")

    glossary = find_section(text, "Glossary")
    if glossary is None:
        errors.append(f"{rel_path}: missing Glossary section")
        return

    rows = [line.strip() for line in glossary.splitlines() if line.strip().startswith("|")]
    data_rows = []
    for line in rows:
        if line.startswith("| Location ") or re.fullmatch(r"\|[-| ]+\|", line):
            continue
        parts = [part.strip() for part in line.strip("|").split("|")]
        if len(parts) >= 3 and any(parts[:3]):
            data_rows.append(parts[:3])

    if status in {"in-progress", "partial", "complete"} and not data_rows:
        warnings.append(f"{rel_path}: glossary is empty for a non-draft feature")

    for location, anchor_type, description in data_rows:
        if "::" not in location:
            errors.append(f"{rel_path}: glossary location must use file::symbol format: {location}")
            continue

        file_part, symbol = location.split("::", 1)
        target_path = (root / file_part).resolve()
        if not target_path.exists():
            errors.append(f"{rel_path}: glossary file does not exist: {file_part}")
            continue

        try:
            content = target_path.read_text()
        except UnicodeDecodeError:
            errors.append(f"{rel_path}: glossary file is not text-readable: {file_part}")
            continue

        if not symbol_exists(content, symbol):
            errors.append(
                f"{rel_path}: glossary anchor does not resolve: {location} ({anchor_type}: {description})"
            )

feature_paths = []
if feature_arg:
    feature_paths = [Path(feature_arg)]
else:
    feature_paths = sorted(path for path in (idd_dir / "features").glob("*.md") if path.name != "_template.md")

if not feature_paths:
    warnings.append("No feature specs found in .github/idd/features")

for feature_path in feature_paths:
    validate_feature(feature_path)

enforce_learned_rules()

if errors:
    print("IDD validation failed")
    for item in errors:
        print(f"- ERROR: {item}")
    for item in warnings:
        print(f"- WARN: {item}")
    sys.exit(1)

print("IDD validation passed")
for item in warnings:
    print(f"- WARN: {item}")
PYEOF
}

case "${1:-}" in
  init)
    cmd_init
    ;;
  learn)
    shift
    cmd_learn "$@"
    ;;
  refresh-conventions)
    shift
    cmd_refresh_conventions "$@"
    ;;
  run)
    shift
    cmd_run "$@"
    ;;
  validate)
    shift
    cmd_validate "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  -v|--version)
    echo "idd v${IDD_VERSION}"
    ;;
  *)
    die "Unknown command: $1"
    ;;
esac
