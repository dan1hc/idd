# IDD Hooks Configuration
# Edit this file to customize hook behavior
# Location: .github/idd/hooks.config

# Enable/disable individual checks
VALIDATE_ENABLED=true    # JSON schema validation
GLOSSARY_ENABLED=true    # Glossary anchor verification
PATTERNS_ENABLED=true    # Learned pattern compliance

# Behavior
WARN_ONLY=false          # If true, hooks warn but don't block commits
