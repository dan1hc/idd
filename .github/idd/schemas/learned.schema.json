{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IDD Learned Rules",
  "description": "Machine-checkable codebase rules that IDD validates",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "glob", "message", "added"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "type": {
            "type": "string",
            "enum": ["forbid_import", "require_import", "forbid_pattern", "require_pattern"]
          },
          "glob": { "type": "string", "minLength": 1 },
          "module": { "type": ["string", "null"], "minLength": 1 },
          "pattern": { "type": ["string", "null"], "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "added": { "type": "string", "format": "date" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "type": { "enum": ["forbid_import", "require_import"] } },
              "required": ["type"]
            },
            "then": {
              "required": ["module"],
              "properties": { "pattern": { "type": "null" } }
            }
          },
          {
            "if": {
              "properties": { "type": { "enum": ["forbid_pattern", "require_pattern"] } },
              "required": ["type"]
            },
            "then": {
              "required": ["pattern"],
              "properties": { "module": { "type": "null" } }
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
